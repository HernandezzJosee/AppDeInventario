<resources xmlns:tools="http://schemas.android.com/tools">
    <!-- Base application theme. -->
    <style name="Base.Theme.SistemaInventario" parent="Theme.Material3.DayNight.NoActionBar">
        <!-- Customize your light theme here. -->
        <!-- <item name="colorPrimary">@color/my_light_primary</item> -->
        <item name="colorPrimary">#388E3C</item>
        <item name="colorPrimaryDark">#2E7D32</item>
        <item name="colorSecondary">#81C784</item>

        <!-- Colores del sistema -->
        <item name="android:statusBarColor">#388E3C</item>
        <item name="android:navigationBarColor">#388E3C</item>

        <!-- Fondo general -->
        <item name="android:windowBackground">#F5F5F5</item>

        <!-- Iconos y texto claros sobre la barra -->
        <item name="android:windowLightStatusBar">false</item>
        <item name="android:windowLightNavigationBar">false</item>
        <item name="android:windowDrawsSystemBarBackgrounds">true</item>

    </style>

    <style name="Theme.SistemaInventario" parent="Base.Theme.SistemaInventario" />
</resources>